{
  "name": "@ai/book-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Markdown book builder CLI with centralized config, style, plugin, HTML and PDF output.",
  "files": [
    "bin/",
    "src/",
    "docs/",
    "scripts/",
    "tests/",
    "README.md",
    "package.json"
  ],
  "bin": {
    "book-cli": "./bin/book-cli.js"
  },
  "scripts": {
    "build:md": "book-cli build-md",
    "build:html": "book-cli build-html",
    "build:pdf": "book-cli build-pdf",
    "build:epub": "book-cli build-epub",
    "build": "book-cli build",
    "check": "node scripts/check-syntax.js",
    "test": "node --test tests/*.test.js",
    "test:smoke": "node scripts/smoke-test.js",
    "test:all": "npm test && npm run test:smoke"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^23.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
